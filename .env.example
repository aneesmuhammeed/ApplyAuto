# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Local llama.cpp AI Endpoint (Running Qwen3-0.6B)
LLAMA_CPP_URL=http://127.0.0.1:1234/v1/chat/completions
LLAMA_MODEL_NAME=qwen3-0.6b

# Worker Polling Interval (in seconds)
POLL_INTERVAL=3

# Headless browser mode (set to False if you want to visually watch Playwright fill forms on your laptop)
HEADLESS_BROWSER=True

# Uploads directory
RESUME_STORAGE_DIR=./storage

