# -----------------------------------------------------------------------------
# Local llama.cpp AI Endpoint & Model Settings
# -----------------------------------------------------------------------------
# ApplyMate runs with a local GGUF model via llama-server (recommended: Qwen2.5-3B-Instruct or Qwen2.5-7B-Instruct).
# IMPORTANT: Start llama-server with `-c 8192` to provide sufficient context for long job postings:
#   llama-server -m models/qwen2.5-3b-instruct-q4_k_m.gguf -c 8192 --port 1234
# Prompt queries append `/no_think` to suppress chain-of-thought tokens and return direct JSON.
LOCAL_LLM_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
LOCAL_LLM_MODEL=tensorblock/Qwen_Qwen3-0.6B-GGUF:Q3_K_M
LLAMA_CPP_URL=http://127.0.0.1:1234/v1/chat/completions
LLAMA_MODEL_NAME=tensorblock/Qwen_Qwen3-0.6B-GGUF:Q3_K_M

# Confidence threshold (0.0 to 1.0) below which AI prompts are deferred to the user
LLM_CONFIDENCE_THRESHOLD=0.8

# -----------------------------------------------------------------------------
# Worker & Browser Runtime Settings
# -----------------------------------------------------------------------------
# Seconds between worker polling loops (1 to 5 seconds recommended)
POLL_INTERVAL=2

# Headless browser mode (set to False to visually watch Playwright fill forms on your laptop)
HEADLESS_BROWSER=False

# Storage directory for local SQLite database, screenshots, and uploaded resumes
RESUME_STORAGE_DIR=./storage

# -----------------------------------------------------------------------------
# Optional Telegram Bot Notifications
# -----------------------------------------------------------------------------
# To receive alerts and approve submissions from your mobile phone, set your bot credentials.
# Format: TELEGRAM_BOT_TOKEN must be <bot_id>:<secret_token>.
# If left as placeholder or disabled, ApplyMate safely skips Telegram sends without crashing.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# Security: Dashboard CORS & Admin API Token
# -----------------------------------------------------------------------------
# Allowed Next.js dashboard origin (never use '*' with credentials)
DASHBOARD_ORIGIN=http://localhost:3000

# Secret random bearer token for API access (if omitted, auto-generated in storage/api_token.txt)
API_TOKEN=your_secure_random_api_token_here
